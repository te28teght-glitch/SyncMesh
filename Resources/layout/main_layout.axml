<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SyncMesh"
            android:textSize="28sp"
            android:textColor="#3F51B5"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="30dp"
            android:layout_marginTop="30dp"
             />

        <!-- Карточка статуса -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ Статус: ожидание"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Кнопка запуска сервера -->
        <Button
            android:id="@+id/startServerButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🚀 Запустить сервер"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Поле для MAC -->
        <EditText
            android:id="@+id/macAddressInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MAC-адрес сервера"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="8dp" />

        <!-- Кнопка подключения -->
        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔌 Подключиться"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Поле для сообщения -->
        <EditText
            android:id="@+id/messageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Сообщение"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="8dp" />

        <!-- Кнопка отправки -->
        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="✉️ Отправить"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Кнопка очистки логов -->
        <Button
            android:id="@+id/clearLogsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🗑️ Очистить логи"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Область логов -->
        <TextView
            android:id="@+id/logTextView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:text="=== Логи ===\n"
            android:textSize="11sp"
            android:typeface="monospace" />

    </LinearLayout>
</ScrollView>